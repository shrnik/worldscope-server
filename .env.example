# Hugging Face (Jobs require a Pro / Team / Enterprise account)
HF_TOKEN=hf_xxx
HF_BUCKET=your-namespace/worldscope
HF_DOWNLOAD_FLAVOR=cpu-upgrade
HF_EMBED_FLAVOR=t4-small
HF_JOB_TIMEOUT=1h

# Embedding checkpoint (must match the one used in jobs/embed_job.py)
EMBED_MODEL=google/tipsv2-b14

# Camera data sources
SHEET_URL=https://sheets.googleapis.com/v4/spreadsheets/.../values/Main?alt=json&key=...
FAA_API_KEY=

# Paths of artifacts inside the bucket
MANIFEST_PATH=manifest.parquet
EMBEDDINGS_PATH=embeddings.parquet
